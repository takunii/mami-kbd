*.history
*~
.DS_Store

# Local ZMK/west build workspace (fetched by `west init`/`west update`;
# GitHub Actions clones these fresh, no need to commit)
/.west/
/.west-build/
/zmk/
# /zephyr/ is NOT ignored wholesale: zephyr/module.yml is a tracked file
# required so west/Zephyr discover boards/shields/ at the repo root.
# Everything else under /zephyr/ (the RTOS clone from `west update`) is ignored.
/zephyr/*
!/zephyr/module.yml
/modules/
/tools/
/bootloader/
/build/
