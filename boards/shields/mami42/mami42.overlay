/*
 * mami42 - 42キー Alice風一体型キーボード (nice!nano v2 / nRF52840)
 * ピンアサインは doc/pin-assignment-final.md を参照
 * row/col と物理キー座標のマッピングは doc/matrix-mapping.md と kle/layout.json を参照
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P0.09 - row0 (左側)
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P0.10 - row1 (左側)
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P1.11 - row2 (左側)
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P1.13 - row3 (左側・親指)
            , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P1.00 - row4 (右側)
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P0.11 - row5 (右側)
            , <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P1.04 - row6 (右側)
            , <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P1.06 - row7 (右側・親指)
            ;

        col-gpios
            = <&gpio0 6  GPIO_ACTIVE_HIGH>   // P0.06 - col0
            , <&gpio0 8  GPIO_ACTIVE_HIGH>   // P0.08 - col1
            , <&gpio0 17 GPIO_ACTIVE_HIGH>   // P0.17 - col2
            , <&gpio0 20 GPIO_ACTIVE_HIGH>   // P0.20 - col3
            , <&gpio0 22 GPIO_ACTIVE_HIGH>   // P0.22 - col4
            , <&gpio0 24 GPIO_ACTIVE_HIGH>   // P0.24 - col5
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <8>;
        map =
            <
        RC(0,0)  /* SW1 */
        RC(1,0)  /* SW2 */
        RC(2,0)  /* SW3 */
        RC(0,1)  /* SW4 */
        RC(1,1)  /* SW5 */
        RC(2,1)  /* SW6 */
        RC(0,2)  /* SW7 */
        RC(1,2)  /* SW8 */
        RC(2,2)  /* SW9 */
        RC(3,2)  /* SW10 */
        RC(0,3)  /* SW11 */
        RC(1,3)  /* SW12 */
        RC(2,3)  /* SW13 */
        RC(3,3)  /* SW14 */
        RC(0,4)  /* SW15 */
        RC(1,4)  /* SW16 */
        RC(2,4)  /* SW17 */
        RC(0,5)  /* SW18 */
        RC(1,5)  /* SW19 */
        RC(2,5)  /* SW20 */
        RC(3,5)  /* SW21 */
        RC(4,5)  /* SW22 */
        RC(5,5)  /* SW23 */
        RC(6,5)  /* SW24 */
        RC(7,5)  /* SW25 */
        RC(4,4)  /* SW26 */
        RC(5,4)  /* SW27 */
        RC(6,4)  /* SW28 */
        RC(4,3)  /* SW29 */
        RC(5,3)  /* SW30 */
        RC(6,3)  /* SW31 */
        RC(7,3)  /* SW32 */
        RC(4,2)  /* SW33 */
        RC(5,2)  /* SW34 */
        RC(6,2)  /* SW35 */
        RC(7,2)  /* SW36 */
        RC(4,1)  /* SW37 */
        RC(5,1)  /* SW38 */
        RC(6,1)  /* SW39 */
        RC(4,0)  /* SW40 */
        RC(5,0)  /* SW41 */
        RC(6,0)  /* SW42 */
            >;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "mami42";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                    w    h     x     y   rot    rx    ry
            =
        <&key_physical_attrs  100  100     0   100     0     0     0>  /* SW1 */
        <&key_physical_attrs  100  100     0   200     0     0     0>  /* SW2 */
        <&key_physical_attrs  100  100     0   300     0     0     0>  /* SW3 */
        <&key_physical_attrs  100  100   100   100     0     0     0>  /* SW4 */
        <&key_physical_attrs  100  100   100   200     0     0     0>  /* SW5 */
        <&key_physical_attrs  100  100   100   300     0     0     0>  /* SW6 */
        <&key_physical_attrs  100  100   214   100   800   200   100>  /* SW7 */
        <&key_physical_attrs  100  100   228   200   800   200   100>  /* SW8 */
        <&key_physical_attrs  100  100   241   300   800   200   100>  /* SW9 */
        <&key_physical_attrs  100  100   250   400   800   200   100>  /* SW10 */
        <&key_physical_attrs  100  100   314   100   800   200   100>  /* SW11 */
        <&key_physical_attrs  100  100   328   200   800   200   100>  /* SW12 */
        <&key_physical_attrs  100  100   341   300   800   200   100>  /* SW13 */
        <&key_physical_attrs  125  100   350   400   800   200   100>  /* SW14 */
        <&key_physical_attrs  100  100   414   100   800   200   100>  /* SW15 */
        <&key_physical_attrs  100  100   428   200   800   200   100>  /* SW16 */
        <&key_physical_attrs  100  100   441   300   800   200   100>  /* SW17 */
        <&key_physical_attrs  100  100   514   100   800   200   100>  /* SW18 */
        <&key_physical_attrs  100  100   528   200   800   200   100>  /* SW19 */
        <&key_physical_attrs  100  100   541   300   800   200   100>  /* SW20 */
        <&key_physical_attrs  200  100   475   400   800   200   100>  /* SW21 */
        <&key_physical_attrs  100  100   786   100  -800  1200   100>  /* SW22 */
        <&key_physical_attrs  100  100   773   200  -800  1200   100>  /* SW23 */
        <&key_physical_attrs  100  100   760   300  -800  1200   100>  /* SW24 */
        <&key_physical_attrs  200  100   726   400  -800  1200   100>  /* SW25 */
        <&key_physical_attrs  100  100   886   100  -800  1200   100>  /* SW26 */
        <&key_physical_attrs  100  100   873   200  -800  1200   100>  /* SW27 */
        <&key_physical_attrs  100  100   860   300  -800  1200   100>  /* SW28 */
        <&key_physical_attrs  100  100   986   100  -800  1200   100>  /* SW29 */
        <&key_physical_attrs  100  100   973   200  -800  1200   100>  /* SW30 */
        <&key_physical_attrs  100  100   960   300  -800  1200   100>  /* SW31 */
        <&key_physical_attrs  125  100   926   400  -800  1200   100>  /* SW32 */
        <&key_physical_attrs  100  100  1086   100  -800  1200   100>  /* SW33 */
        <&key_physical_attrs  100  100  1073   200  -800  1200   100>  /* SW34 */
        <&key_physical_attrs  100  100  1060   300  -800  1200   100>  /* SW35 */
        <&key_physical_attrs  100  100  1026   400  -800  1200   100>  /* SW36 */
        <&key_physical_attrs  100  100  1200   100     0     0     0>  /* SW37 */
        <&key_physical_attrs  100  100  1200   200     0     0     0>  /* SW38 */
        <&key_physical_attrs  100  100  1200   300     0     0     0>  /* SW39 */
        <&key_physical_attrs  100  100  1300   100     0     0     0>  /* SW40 */
        <&key_physical_attrs  100  100  1300   200     0     0     0>  /* SW41 */
        <&key_physical_attrs  100  100  1300   300     0     0     0>  /* SW42 */
            ;
    };
};
