/*
 * mami42 keymap
 *
 * レイヤー構成:
 *   0 mac_base   : Mac用ベースレイヤー (QWERTY)
 *   1 mac_num    : Mac用 数字/矢印/記号/BT選択/RGBレイヤー
 *   2 mac_system : Mac用 ファンクションキー/画面輝度/音量レイヤー
 *   3 win_base   : Windows用ベースレイヤー
 *                  (mac_baseのSW10とSW14を入れ替えたもの)
 *   4 win_num    : Windows用 数字/矢印/記号/BT選択/RGBレイヤー (mac_numと同一)
 *   5 win_system : Windows用 ファンクションキー/画面輝度/音量レイヤー (mac_systemと同一)
 *
 * OS切り替え: 左手中央親指キー(mac_baseではSW14、win_baseではSW10。
 *             どちらもMO(1/4)キー) + 右手中央親指キー(SW32、MO(2/5)キー)の
 *             同時押しコンボでwin_base(レイヤー3)をトグルします。コンボは
 *             物理位置(SW14+SW32)で発火するため、実際のバインディング内容に
 *             関わらず動作します。mac/win それぞれの base layer はすべての
 *             キーを明示的に定義しているので、win_base を on にするだけで
 *             mac_base を隠す(Windowsモードになる)、off にすると mac_base に戻ります。
 *
 * このファイルはたたき台です。実際の割り当ては ZMK Studio でも調整できます。
 * ベースレイヤーの物理配置は kle/layout.json と doc/matrix-mapping.md を参照してください。
 *
 * bindings配列の並びについて:
 *   各レイヤーの bindings は SW1〜SW42 の物理位置順(mami42.overlay の
 *   default_transform / physical_layout と同じ順序)で並べています。
 *   見た目通りの行優先(TAB Q W E R T / ESC A S D F G / ...)では
 *   ズレるので注意してください。各行のコメントに SW番号と (row,col) を
 *   記載しています。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        // サンプルマクロ: 記号レイヤーの空きキーで "->" を入力する例
        arrow_macro: arrow_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };

        // BT_SEL/&out に単体の名前を付けて、ZMK Studioの一覧で
        // 「BLT1」「BLT2」「BLT3」「USB」として単独選択できるようにする
        blt1: blt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BLT1";
            bindings = <&bt BT_SEL 0>;
        };

        blt2: blt2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BLT2";
            bindings = <&bt BT_SEL 1>;
        };

        blt3: blt3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BLT3";
            bindings = <&bt BT_SEL 2>;
        };

        usb_out: usb_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "USB";
            bindings = <&out OUT_USB>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_os_toggle {
            timeout-ms = <50>;
            key-positions = <13 31>;  // 左中央親指(SW14) + 右中央親指(SW32)
            bindings = <&tog 3>;
        };

        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <2 41>;  // 左Shift(SW3) + 右Shift(SW42)
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_base {
            display-name = "mac_base";
            bindings = <
            &kp GRAVE       // SW1  (row0,col0)
            &mt LCTRL TAB   // SW2  (row1,col0)
            &kp LSHFT       // SW3  (row2,col0)
            &kp Q           // SW4  (row0,col1)
            &kp A           // SW5  (row1,col1)
            &kp Z           // SW6  (row2,col1)
            &kp W           // SW7  (row0,col2)
            &kp S           // SW8  (row1,col2)
            &kp X           // SW9  (row2,col2)
            &kp LALT        // SW10 (row3,col2) 左親指
            &kp E           // SW11 (row0,col3)
            &kp D           // SW12 (row1,col3)
            &kp C           // SW13 (row2,col3)
            &kp LGUI        // SW14 (row3,col3) 左親指
            &kp R           // SW15 (row0,col4)
            &kp F           // SW16 (row1,col4)
            &kp V           // SW17 (row2,col4)
            &kp T           // SW18 (row0,col5)
            &kp G           // SW19 (row1,col5)
            &kp B           // SW20 (row2,col5)
            &lt 1 BSPC      // SW21 (row3,col5) 左親指
            &kp Y           // SW22 (row4,col5)
            &kp H           // SW23 (row5,col5)
            &kp N           // SW24 (row6,col5)
            &lt 1 SPACE     // SW25 (row7,col5) 右親指
            &kp U           // SW26 (row4,col4)
            &kp J           // SW27 (row5,col4)
            &kp M           // SW28 (row6,col4)
            &kp I           // SW29 (row4,col3)
            &kp K           // SW30 (row5,col3)
            &kp COMMA       // SW31 (row6,col3)
            &kp RALT        // SW32 (row7,col3) 右親指
            &kp O           // SW33 (row4,col2)
            &kp L           // SW34 (row5,col2)
            &kp DOT         // SW35 (row6,col2)
            &mo 2           // SW36 (row7,col2) 右親指
            &kp P           // SW37 (row4,col1)
            &kp SEMI        // SW38 (row5,col1)
            &kp FSLH        // SW39 (row6,col1)
            &kp MINUS       // SW40 (row4,col0)
            &kp RET         // SW41 (row5,col0)
            &kp RSHFT       // SW42 (row6,col0)
            >;
        };

        mac_num {
            display-name = "mac_num";
            bindings = <
            &kp ESC       // SW1  (row0,col0)
            &blt1         // SW2  (row1,col0)
            &blt2         // SW3  (row2,col0)
            &kp N1        // SW4  (row0,col1)
            &kp LEFT      // SW5  (row1,col1)
            &kp HOME      // SW6  (row2,col1)
            &kp N2        // SW7  (row0,col2)
            &kp UP        // SW8  (row1,col2)
            &kp PG_UP     // SW9  (row2,col2)
            &trans        // SW10 (row3,col2) 左親指
            &kp N3        // SW11 (row0,col3)
            &kp DOWN      // SW12 (row1,col3)
            &kp PG_DN     // SW13 (row2,col3)
            &trans        // SW14 (row3,col3) 左親指
            &kp N4        // SW15 (row0,col4)
            &kp RIGHT     // SW16 (row1,col4)
            &kp END       // SW17 (row2,col4)
            &kp N5        // SW18 (row0,col5)
            &blt3         // SW19 (row1,col5)
            &rgb_ug RGB_TOG // SW20 (row2,col5)
            &kp BSPC      // SW21 (row3,col5) 左親指
            &kp N6        // SW22 (row4,col5)
            &rgb_ug RGB_EFF // SW23 (row5,col5)
            &rgb_ug RGB_HUI // SW24 (row6,col5)
            &kp SPACE     // SW25 (row7,col5) 右親指
            &kp N7        // SW26 (row4,col4)
            &kp LBRC      // SW27 (row5,col4)
            &rgb_ug RGB_HUD // SW28 (row6,col4)
            &kp N8        // SW29 (row4,col3)
            &kp RBRC      // SW30 (row5,col3)
            &rgb_ug RGB_BRI // SW31 (row6,col3)
            &trans        // SW32 (row7,col3) 右親指
            &kp N9        // SW33 (row4,col2)
            &kp SEMI      // SW34 (row5,col2)
            &rgb_ug RGB_BRD // SW35 (row6,col2)
            &trans        // SW36 (row7,col2) 右親指
            &kp N0        // SW37 (row4,col1)
            &kp SQT       // SW38 (row5,col1)
            &trans        // SW39 (row6,col1)
            &kp EQUAL     // SW40 (row4,col0)
            &kp BSLH      // SW41 (row5,col0)
            &trans        // SW42 (row6,col0)
            >;
        };

        mac_system {
            display-name = "mac_system";
            bindings = <
            &kp F1        // SW1  (row0,col0)
            &trans        // SW2  (row1,col0)
            &trans        // SW3  (row2,col0)
            &kp F2        // SW4  (row0,col1)
            &trans        // SW5  (row1,col1)
            &kp C_BRI_DN  // SW6  (row2,col1)
            &kp F3        // SW7  (row0,col2)
            &trans        // SW8  (row1,col2)
            &kp C_BRI_UP  // SW9  (row2,col2)
            &trans        // SW10 (row3,col2) 左親指
            &kp F4        // SW11 (row0,col3)
            &trans        // SW12 (row1,col3)
            &kp C_VOL_DN  // SW13 (row2,col3)
            &trans        // SW14 (row3,col3) 左親指
            &kp F5        // SW15 (row0,col4)
            &trans        // SW16 (row1,col4)
            &kp C_VOL_UP  // SW17 (row2,col4)
            &kp F6        // SW18 (row0,col5)
            &trans        // SW19 (row1,col5)
            &kp C_MUTE    // SW20 (row2,col5)
            &trans        // SW21 (row3,col5) 左親指
            &kp F7        // SW22 (row4,col5)
            &trans        // SW23 (row5,col5)
            &trans        // SW24 (row6,col5)
            &trans        // SW25 (row7,col5) 右親指
            &kp F8        // SW26 (row4,col4)
            &trans        // SW27 (row5,col4)
            &trans        // SW28 (row6,col4)
            &kp F9        // SW29 (row4,col3)
            &trans        // SW30 (row5,col3)
            &trans        // SW31 (row6,col3)
            &trans        // SW32 (row7,col3) 右親指
            &kp F10       // SW33 (row4,col2)
            &trans        // SW34 (row5,col2)
            &trans        // SW35 (row6,col2)
            &trans        // SW36 (row7,col2) 右親指
            &kp F11       // SW37 (row4,col1)
            &trans        // SW38 (row5,col1)
            &trans        // SW39 (row6,col1)
            &kp F12       // SW40 (row4,col0)
            &trans        // SW41 (row5,col0)
            &trans        // SW42 (row6,col0)
            >;
        };

        win_base {
            display-name = "win_base";
            // mac_base の SW10 と SW14 を入れ替えたもの
            bindings = <
            &kp GRAVE       // SW1  (row0,col0)
            &mt LCTRL TAB   // SW2  (row1,col0)
            &kp LSHFT       // SW3  (row2,col0)
            &kp Q           // SW4  (row0,col1)
            &kp A           // SW5  (row1,col1)
            &kp Z           // SW6  (row2,col1)
            &kp W           // SW7  (row0,col2)
            &kp S           // SW8  (row1,col2)
            &kp X           // SW9  (row2,col2)
            &kp LGUI        // SW10 (row3,col2) 左親指 (mac_baseのSW14と入替)
            &kp E           // SW11 (row0,col3)
            &kp D           // SW12 (row1,col3)
            &kp C           // SW13 (row2,col3)
            &kp LALT        // SW14 (row3,col3) 左親指 (mac_baseのSW10と入替)
            &kp R           // SW15 (row0,col4)
            &kp F           // SW16 (row1,col4)
            &kp V           // SW17 (row2,col4)
            &kp T           // SW18 (row0,col5)
            &kp G           // SW19 (row1,col5)
            &kp B           // SW20 (row2,col5)
            &lt 4 BSPC      // SW21 (row3,col5) 左親指
            &kp Y           // SW22 (row4,col5)
            &kp H           // SW23 (row5,col5)
            &kp N           // SW24 (row6,col5)
            &lt 4 SPACE     // SW25 (row7,col5) 右親指
            &kp U           // SW26 (row4,col4)
            &kp J           // SW27 (row5,col4)
            &kp M           // SW28 (row6,col4)
            &kp I           // SW29 (row4,col3)
            &kp K           // SW30 (row5,col3)
            &kp COMMA       // SW31 (row6,col3)
            &kp RALT        // SW32 (row7,col3) 右親指
            &kp O           // SW33 (row4,col2)
            &kp L           // SW34 (row5,col2)
            &kp DOT         // SW35 (row6,col2)
            &mo 5           // SW36 (row7,col2) 右親指
            &kp P           // SW37 (row4,col1)
            &kp SEMI        // SW38 (row5,col1)
            &kp FSLH        // SW39 (row6,col1)
            &kp MINUS       // SW40 (row4,col0)
            &kp RET         // SW41 (row5,col0)
            &kp RSHFT       // SW42 (row6,col0)
            >;
        };

        win_num {
            display-name = "win_num";
            // mac_num と同一 (SW10/SW14は共に&transのため入替の影響なし)
            bindings = <
            &kp ESC       // SW1  (row0,col0)
            &blt1         // SW2  (row1,col0)
            &blt2         // SW3  (row2,col0)
            &kp N1        // SW4  (row0,col1)
            &kp LEFT      // SW5  (row1,col1)
            &kp HOME      // SW6  (row2,col1)
            &kp N2        // SW7  (row0,col2)
            &kp UP        // SW8  (row1,col2)
            &kp PG_UP     // SW9  (row2,col2)
            &trans        // SW10 (row3,col2) 左親指
            &kp N3        // SW11 (row0,col3)
            &kp DOWN      // SW12 (row1,col3)
            &kp PG_DN     // SW13 (row2,col3)
            &trans        // SW14 (row3,col3) 左親指
            &kp N4        // SW15 (row0,col4)
            &kp RIGHT     // SW16 (row1,col4)
            &kp END       // SW17 (row2,col4)
            &kp N5        // SW18 (row0,col5)
            &blt3         // SW19 (row1,col5)
            &rgb_ug RGB_TOG // SW20 (row2,col5)
            &kp BSPC      // SW21 (row3,col5) 左親指
            &kp N6        // SW22 (row4,col5)
            &rgb_ug RGB_EFF // SW23 (row5,col5)
            &rgb_ug RGB_HUI // SW24 (row6,col5)
            &kp SPACE     // SW25 (row7,col5) 右親指
            &kp N7        // SW26 (row4,col4)
            &kp LBRC      // SW27 (row5,col4)
            &rgb_ug RGB_HUD // SW28 (row6,col4)
            &kp N8        // SW29 (row4,col3)
            &kp RBRC      // SW30 (row5,col3)
            &rgb_ug RGB_BRI // SW31 (row6,col3)
            &trans        // SW32 (row7,col3) 右親指
            &kp N9        // SW33 (row4,col2)
            &kp SEMI      // SW34 (row5,col2)
            &rgb_ug RGB_BRD // SW35 (row6,col2)
            &trans        // SW36 (row7,col2) 右親指
            &kp N0        // SW37 (row4,col1)
            &kp SQT       // SW38 (row5,col1)
            &trans        // SW39 (row6,col1)
            &kp EQUAL     // SW40 (row4,col0)
            &kp BSLH      // SW41 (row5,col0)
            &trans        // SW42 (row6,col0)
            >;
        };

        win_system {
            display-name = "win_system";
            // mac_system と同一 (SW10/SW14は共に&transのため入替の影響なし)
            bindings = <
            &kp F1        // SW1  (row0,col0)
            &trans        // SW2  (row1,col0)
            &trans        // SW3  (row2,col0)
            &kp F2        // SW4  (row0,col1)
            &trans        // SW5  (row1,col1)
            &kp C_BRI_DN  // SW6  (row2,col1)
            &kp F3        // SW7  (row0,col2)
            &trans        // SW8  (row1,col2)
            &kp C_BRI_UP  // SW9  (row2,col2)
            &trans        // SW10 (row3,col2) 左親指
            &kp F4        // SW11 (row0,col3)
            &trans        // SW12 (row1,col3)
            &kp C_VOL_DN  // SW13 (row2,col3)
            &trans        // SW14 (row3,col3) 左親指
            &kp F5        // SW15 (row0,col4)
            &trans        // SW16 (row1,col4)
            &kp C_VOL_UP  // SW17 (row2,col4)
            &kp F6        // SW18 (row0,col5)
            &trans        // SW19 (row1,col5)
            &kp C_MUTE    // SW20 (row2,col5)
            &trans        // SW21 (row3,col5) 左親指
            &kp F7        // SW22 (row4,col5)
            &trans        // SW23 (row5,col5)
            &trans        // SW24 (row6,col5)
            &trans        // SW25 (row7,col5) 右親指
            &kp F8        // SW26 (row4,col4)
            &trans        // SW27 (row5,col4)
            &trans        // SW28 (row6,col4)
            &kp F9        // SW29 (row4,col3)
            &trans        // SW30 (row5,col3)
            &trans        // SW31 (row6,col3)
            &trans        // SW32 (row7,col3) 右親指
            &kp F10       // SW33 (row4,col2)
            &trans        // SW34 (row5,col2)
            &trans        // SW35 (row6,col2)
            &trans        // SW36 (row7,col2) 右親指
            &kp F11       // SW37 (row4,col1)
            &trans        // SW38 (row5,col1)
            &trans        // SW39 (row6,col1)
            &kp F12       // SW40 (row4,col0)
            &trans        // SW41 (row5,col0)
            &trans        // SW42 (row6,col0)
            >;
        };
    };
};
